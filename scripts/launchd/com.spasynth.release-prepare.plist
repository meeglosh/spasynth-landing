<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Prepares a new SPASynth version on spasynth.com whenever the product ships one.

  Install (one time):
    cp scripts/launchd/com.spasynth.release-prepare.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.spasynth.release-prepare.plist

  Check on it:
    tail ~/Library/Logs/spasynth-release-prepare.log
    launchctl list | grep spasynth

  Stop it:
    launchctl unload ~/Library/LaunchAgents/com.spasynth.release-prepare.plist

  WatchPaths fires on every commit in ~/spasynth (.git/logs/HEAD is appended by
  each one) and on any save of the changelog itself. That is deliberately noisy:
  when the version has not moved, prepare-release.py exits in milliseconds
  having touched nothing. StartCalendarInterval is a daily backstop in case a
  watch is missed while the Mac is asleep.

  This job NEVER pushes. It prepares a local commit and posts a notification;
  Mike reviews and pushes when the build is actually downloadable. See the
  docstring in scripts/prepare-release.py for why.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.spasynth.release-prepare</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/mikejerugim/spasynth-landing/scripts/prepare-release.py</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/mikejerugim/spasynth-landing</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>WatchPaths</key>
    <array>
        <string>/Users/mikejerugim/spasynth/.git/logs/HEAD</string>
        <string>/Users/mikejerugim/spasynth/docs/CHANGELOG.md</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>11</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/Users/mikejerugim/Library/Logs/spasynth-release-prepare.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/mikejerugim/Library/Logs/spasynth-release-prepare.log</string>
</dict>
</plist>
